{
  "manifest_version": 3,
  "name": "Chrome Extension Base",
  "version": "0.1.0",
  "description": "TypeScript と Vite で作る Chrome 拡張のスターター。",
  "minimum_chrome_version": "124",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.sampleapis.com/*"
  ],
  "action": {
    "default_title": "Quick Note",
    "default_popup": "index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
