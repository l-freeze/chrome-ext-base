{
  "name": "chrome-ext-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:extension": "vite build --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run typecheck && vite build",
    "check": "pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.6",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
