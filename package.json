{
  "name": "chrome-ext-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "dev:sidepanel": "vite --mode sidepanel --open /sidepanel.html",
    "dev:extension": "vite build --mode popup --watch",
    "dev:extension:sidepanel": "vite build --mode sidepanel --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "test": "vitest run --exclude \"tests/extension/**\" --exclude \"tests/examples/**\"",
    "test:watch": "vitest --exclude \"tests/extension/**\" --exclude \"tests/examples/**\"",
    "test:examples": "vitest run tests/examples",
    "test:extension": "vitest run tests/extension",
    "test:extension:sidepanel": "vitest run tests/extension --mode sidepanel",
    "build": "pnpm run build:popup",
    "build:popup": "pnpm run typecheck && vite build --mode popup",
    "build:sidepanel": "pnpm run typecheck && vite build --mode sidepanel",
    "check": "pnpm run test && pnpm run build:popup && pnpm run test:extension",
    "check:sidepanel": "pnpm run test && pnpm run build:sidepanel && pnpm run test:extension:sidepanel"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.6",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "solid-js": "1.9.18"
  }
}
